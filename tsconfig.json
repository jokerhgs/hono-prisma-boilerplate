{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "noEmit": true,
    "paths": {
      "cloudflare:test": [
        "./node_modules/@cloudflare/vitest-pool-workers/types/cloudflare-test.d.ts"
      ]
    }
  },
  "include": ["src", "tests", "vitest.config.ts", "drizzle.config.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules"]
}
